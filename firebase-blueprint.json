{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in AuraChat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "phone": { "type": "string" },
        "bio": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "displayName", "username"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Chat channel or dialog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string" },
        "unreadCount": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "type", "title"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "type": { "type": "string" },
        "content": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "chatId", "senderId", "type", "content"]
    },
    "Post": {
      "title": "Post",
      "description": "Feed post or reel clip",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "caption": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string" },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "authorId", "caption", "mediaUrl"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Conversations and channels"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a conversation"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Social feed posts and reels"
    }
  }
}
